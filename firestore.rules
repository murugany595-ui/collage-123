rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /test_collection/{docId} {
      allow read, write: if true;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'JhznkT9avjb2aVjIIQJvBtEhAKF2' ||
        request.auth.uid == 'sueMVrzDUidzgEwpfyhwf5XIWLu2' ||
        request.auth.uid == 'kPOA5swWcJeVDd7ex4Snb18Uo7E3' ||
        request.auth.uid == 'cpb3wGY6k4W1dlfSemBT6QN2lyH3' ||
        request.auth.uid == '8x7NPd2ZUNVH53LNgXDUBSASNrb2' ||
        request.auth.token.email == 'murugany595@gmail.com' ||
        request.auth.token.email == 'murugany@gmail.com' ||
        request.auth.token.email == 'admin@brightwood.edu' ||
        request.auth.token.email == 'admin@college.edu' ||
        request.auth.token.email == 'vengadeshvengadesh76066@gmail.com' ||
        request.auth.token.role == 'admin'
      );
    }

    function isAccountant() {
      return isSignedIn() && (
        request.auth.token.email == 'murugany595@gmail.com' ||
        request.auth.token.email == 'murugany@gmail.com' ||
        request.auth.token.email == 'accounts@brightwood.edu' ||
        request.auth.token.email == 'accountant@college.edu' ||
        request.auth.token.role == 'accountant' ||
        exists(/databases/$(database)/documents/accountancy/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'accountant')
      );
    }

    function isStudent() {
      return isSignedIn() && (
        request.auth.token.role == 'student'
      );
    }

    function isParent() {
      return isSignedIn() && (
        request.auth.token.role == 'parent'
      );
    }

    // 1. ADMINS COLLECTION
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 2. ACCOUNTANCY STAFF COLLECTION
    match /accountancy/{accountancyId} {
      allow read, write: if true;
    }

    // 3. DEPARTMENTS & DEPARTMENT SUBCOLLECTIONS
    match /departments/{departmentId} {
      allow read: if true;
      allow write: if isAdmin();

      // Department-isolated student records
      match /students/{studentId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Department-level Fee Records & Payments
      match /fees/{feeId} {
        allow read: if true;
        allow create, update, delete: if isAdmin() || isAccountant();
      }

      // Department-level Attendance
      match /attendance/{attendanceId} {
        allow create, update, delete: if isAdmin() || isAccountant();
        allow get, list: if isSignedIn();
      }

      // Department-level Exams
      match /exams/{examId} {
        allow create, update, delete: if isAdmin() || isAccountant();
        allow get, list: if isSignedIn();
      }

      // Department-level Expenses
      match /expenses/{expenseId} {
        allow read: if true;
        allow write: if isAdmin() || isAccountant();
      }

      // Department Staff
      match /staff/{staffId} {
        allow read: if isSignedIn();
        allow write: if isAdmin() || isAccountant();
      }
    }

    // Top-level Staff collection
    match /staff/{staffId} {
      allow read, write: if true;
    }

    match /staffs/{staffId} {
      allow read, write: if true;
    }

    // 4. PARENTS COLLECTION
    match /parents/{parentId} {
      allow read, write: if true;
    }

    // 5. EXPENSES & SALARIES COLLECTIONS
    match /expenses/{expenseId} {
      allow read, write: if true;
    }

    match /adminExpenses/{expenseId} {
      allow read, write: if true;
    }

    match /student_fees/{feeId} {
      allow read, write: if true;
    }

    match /salaries/{salaryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isAccountant();
    }

    match /salary_payments/{paymentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isAccountant();
    }

    match /staff_salaries/{salaryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isAccountant();
    }

    // 6. FEE SETTINGS COLLECTIONS
    match /feeSettings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /fee_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 7. FEE PAYMENTS COLLECTION
    match /feePayments/{paymentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isAccountant();
    }

    // 8. ATTENDANCE COLLECTION
    match /attendance/{attendanceId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 9. EXAMS
    match /examFeePayments/{paymentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isAccountant();
    }

    match /exams/{examId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isAccountant();
    }

    // 10. USER PROFILES
    match /users/{userId} {
      allow read: if true;
      allow write: if isAdmin() || (isSignedIn() && userId == request.auth.uid);
    }

    // 11. AUDIT LOGS
    match /auditLogs/{logId} {
      allow read: if isAdmin() || isAccountant();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // 12. NOTIFICATIONS & ANNOUNCEMENTS
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isAdmin() || isAccountant();
    }

    // 13. CHAT CONVERSATIONS & MESSAGES
    match /chat_conversations/{userId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // 14. STUDENT AUTH & LOGIN MAPPINGS
    // Public read so students can resolve login credentials by register number before auth
    match /student_auth/{registerId} {
      allow read: if true;
      allow write: if true;
    }

    // Top-level students collection fallback
    match /students/{studentId} {
      allow read, write: if true;
    }
  }
}
