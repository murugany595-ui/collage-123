rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /test_collection/{docId} {
      allow read, write: if true;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Administrative Role Check
    // Includes bootstrapped developer/admin emails and trusted database role collections
    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'JhznkT9avjb2aVjIIQJvBtEhAKF2' ||
        request.auth.uid == 'sueMVrzDUidzgEwpfyhwf5XIWLu2' ||
        request.auth.token.email == 'murugany595@gmail.com' ||
        request.auth.token.email == 'admin@brightwood.edu' ||
        request.auth.token.email == 'admin@college.edu' ||
        request.auth.token.email == 'vengadeshvengadesh76066@gmail.com' ||
        (request.auth.token.keys().hasAny(['email']) && (
          request.auth.token.email.lower() in [
            'murugany595@gmail.com',
            'admin@brightwood.edu',
            'admin@college.edu',
            'vengadeshvengadesh76066@gmail.com'
          ] ||
          request.auth.token.email.lower().matches('.*admin.*')
        )) ||
        request.auth.token.role == 'admin'
      );
    }

    // Accountant Role Check
    function isAccountant() {
      return isSignedIn() && (
        request.auth.token.email == 'accounts@brightwood.edu' ||
        request.auth.token.email == 'accountant@college.edu' ||
        (request.auth.token.keys().hasAny(['email']) && (
          request.auth.token.email.lower() == 'accounts@brightwood.edu' ||
          request.auth.token.email.lower() == 'accountant@college.edu' ||
          request.auth.token.email.lower().matches('.*account.*')
        )) ||
        request.auth.token.role == 'accountant'
      );
    }

    // Student Role Check
    function isStudent() {
      return isSignedIn() && (
        (request.auth.token.keys().hasAny(['email']) && (
          request.auth.token.email.matches('.*student.*') ||
          request.auth.token.email.matches('.*@student\\..*')
        )) ||
        request.auth.token.role == 'student'
      );
    }

    // Parent Role Check
    function isParent() {
      return isSignedIn() && (
        request.auth.token.role == 'parent'
      );
    }

    // 1. ADMINS COLLECTION
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 2. ACCOUNTANCY STAFF COLLECTION
    match /accountancy/{accountancyId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 3. DEPARTMENTS & DEPARTMENT SUBCOLLECTIONS
    match /departments/{departmentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      // Department-isolated student records
      // Admin: full access
      // Accountant: read access for fee reconciliation
      // Student: read own record and list department for fee and academic matching
      // Parent: read linked student record only
      match /students/{studentId} {
        allow create, update, delete: if isAdmin();
        allow get: if isAdmin() || isAccountant() ||
          (isStudent() && (
            studentId == request.auth.uid ||
            resource.data.studentId == request.auth.uid ||
            resource.data.uid == request.auth.uid ||
            resource.data.authUid == request.auth.uid ||
            resource.data.email == request.auth.token.email ||
            resource.data.authEmail == request.auth.token.email ||
            resource.data.registerNumber == request.auth.token.email.split('@')[0] ||
            resource.data.rollNo == request.auth.token.email.split('@')[0]
          )) ||
          (isParent() && (
            resource.data.parentId == request.auth.uid ||
            (exists(/databases/$(database)/documents/parents/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/parents/$(request.auth.uid)).data.linkedStudentId == studentId)
          ));
        allow list: if isAdmin() || isAccountant() || isStudent();
      }

      // Department-level Fee Records & Payments
      // Admin: full access
      // Accountant: read/write (record collections and updates)
      // Student / Parent: read own fees only
      match /fees/{feeId} {
        allow create, update, delete: if isAdmin() || isAccountant();
        allow get: if isAdmin() || isAccountant() ||
          (isStudent() && (
            resource.data.studentId == request.auth.uid ||
            resource.data.uid == request.auth.uid ||
            resource.data.studentRegisterNumber == request.auth.token.email.split('@')[0] ||
            resource.data.rollNo == request.auth.token.email.split('@')[0]
          )) ||
          (isParent() && exists(/databases/$(database)/documents/parents/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/parents/$(request.auth.uid)).data.linkedStudentId == resource.data.studentId);
        allow list: if isAdmin() || isAccountant() || isStudent() || isParent();
      }

      // Department-level Attendance
      match /attendance/{attendanceId} {
        allow create, update, delete: if isAdmin() || isAccountant();
        allow get, list: if isAdmin() || isAccountant() || isStudent() || isParent();
      }

      // Department-level Exams
      match /exams/{examId} {
        allow create, update, delete: if isAdmin() || isAccountant();
        allow get, list: if isAdmin() || isAccountant() || isStudent() || isParent();
      }

      // Department-level Expenses
      match /expenses/{expenseId} {
        allow read: if isSignedIn();
        allow write: if isAdmin() || isAccountant();
      }

      // Department Staff
      match /staff/{staffId} {
        allow read: if isSignedIn();
        allow write: if isAdmin() || isAccountant();
      }
    }

    // Top-level Staff collection
    match /staff/{staffId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isAccountant();
    }

    // 4. PARENTS COLLECTION
    match /parents/{parentId} {
      allow get: if isAdmin() || (isParent() && (parentId == request.auth.uid || resource.data.email == request.auth.token.email));
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // 5. EXPENSES & SALARIES COLLECTIONS
    // Expenses & Admin Expenses: readable for dashboard, reports, financial overview; write restricted to Admin & Accountant
    match /expenses/{expenseId} {
      allow read: if true;
      allow write: if isAdmin() || isAccountant();
    }

    match /adminExpenses/{expenseId} {
      allow read: if true;
      allow write: if isAdmin() || isAccountant();
    }

    match /salaries/{salaryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isAccountant();
    }

    match /salary_payments/{paymentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isAccountant();
    }

    match /staff_salaries/{salaryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isAccountant();
    }

    // 6. FEE SETTINGS COLLECTIONS (feeSettings & fee_settings)
    // Admin: full access (create, update, delete)
    // Accountant: read-only access, DENIED access to update/write
    match /feeSettings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /fee_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 7. FEE PAYMENTS COLLECTION
    // Admin & Accountant: read and write
    // Student & Parent: read own payment records only
    match /feePayments/{paymentId} {
      allow read, write: if isAdmin() || isAccountant();
      allow get: if isAdmin() || isAccountant() ||
        (isStudent() && resource.data.studentId == request.auth.uid) ||
        (isParent() && exists(/databases/$(database)/documents/parents/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/parents/$(request.auth.uid)).data.linkedStudentId == resource.data.studentId);
    }

    // 8. ATTENDANCE COLLECTION
    match /attendance/{attendanceId} {
      allow write: if isAdmin();
      allow get, list: if isAdmin() || isAccountant() ||
        (isStudent() && resource.data.studentId == request.auth.uid) ||
        (isParent() && exists(/databases/$(database)/documents/parents/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/parents/$(request.auth.uid)).data.linkedStudentId == resource.data.studentId);
    }

    // 9. EXAM FEE PAYMENTS & EXAMS COLLECTIONS
    match /examFeePayments/{paymentId} {
      allow read, write: if isAdmin() || isAccountant();
      allow get: if isAdmin() || isAccountant() ||
        (isStudent() && resource.data.studentId == request.auth.uid) ||
        (isParent() && exists(/databases/$(database)/documents/parents/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/parents/$(request.auth.uid)).data.linkedStudentId == resource.data.studentId);
    }

    match /exams/{examId} {
      allow read, write: if isAdmin() || isAccountant();
      allow get, list: if isAdmin() || isAccountant() || isStudent() || isParent();
    }

    // 10. USER PROFILES
    match /users/{userId} {
      allow get: if isSignedIn() && (userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && (userId == request.auth.uid || isAdmin());
      allow update: if isAdmin() || (isSignedIn() && userId == request.auth.uid && (!incoming().diff(existing()).affectedKeys().hasAny(['role'])));
      allow delete: if isAdmin();
    }

    // 11. AUDIT LOGS (Immutable Security Trail)
    // Admin & Accountant: read all audit trails
    // Create: Authenticated users or admins recording actions, enforcing required audit properties
    // Updates/Deletions: Strictly prohibited (immutable)
    match /auditLogs/{logId} {
      allow read: if isAdmin() || isAccountant();
      allow create: if isSignedIn() &&
        incoming().keys().hasAll(['userId', 'role', 'timestamp', 'action', 'affectedDocumentId']);
      allow update, delete: if false;
    }

    // 12. NOTIFICATIONS & ANNOUNCEMENTS
    // Read: Authenticated users (students, parents, staff, admins)
    // Create/Delete: Admin or Accountant
    // Update: Authenticated users can update read/readBy status
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin() || isAccountant();
      allow update: if isSignedIn();
    }

    // 13. CHAT CONVERSATIONS & MESSAGES
    // Authenticated users can access only their own conversation and messages; Admin can review
    match /chat_conversations/{userId} {
      allow read, write: if isSignedIn() && (
        userId == request.auth.uid ||
        request.auth.token.email == 'murugany595@gmail.com' ||
        request.auth.token.email == 'admin@brightwood.edu'
      );

      match /messages/{messageId} {
        allow read, write: if isSignedIn() && (
          userId == request.auth.uid ||
          request.auth.token.email == 'murugany595@gmail.com' ||
          request.auth.token.email == 'admin@brightwood.edu'
        );
      }
    }

    // 14. STUDENT AUTH & LOGIN MAPPINGS
    // Public read so students can resolve login credentials by register number before auth
    // Write: Admin or authenticated student updating own mapping
    match /student_auth/{registerId} {
      allow get, list: if true;
      allow write: if isAdmin() || (isSignedIn() && (request.resource.data.studentId == request.auth.uid || request.resource.data.uid == request.auth.uid));
    }
  }
}
